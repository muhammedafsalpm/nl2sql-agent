# Copy to .env.local (gitignored) only if you need it. Vite exposes VITE_* vars to the browser,
# so never put a database password or an OpenAI key here.

# Set this ONLY when the backend has API_KEY set in backend/.env. It is sent as X-API-Key.
# Anything here ships in the JS bundle — for a real deployment, terminate auth at a proxy instead.
VITE_API_KEY=
