# Secrets — never commit
.env
# Any .env variant, including timestamped backups - these hold live credentials.
.env.*
!.env.example

# ── Backend (Python) ────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Tooling caches
.mypy_cache/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# App runtime artifacts.
# NOTE: gitignore has no inline comments — a comment after a pattern breaks it.
# cached schema.txt + value_hints.txt (regenerated with: python -m app.db.introspect)
**/.cache/
backend/.cache/
# rotating chatbot.log files
logs/
*.log

# ── Frontend (Node) ─────────────────────────────────────────────────────────────
node_modules/
frontend/dist/
frontend/.vite/
*.local
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── OS / editor ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/

# TypeScript incremental-build cache (regenerated by `npm run build`)
*.tsbuildinfo

# Voice model files - downloaded by backend/scripts/setup_voice.py, ~60 MB, not source.
backend/models/
