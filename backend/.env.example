# Copy to .env and fill in real values. NEVER commit .env.

# ── Your assistant ──────────────────────────────────────────────────────────────
# Display name used in the web UI, API docs, CLI banner and export file names.
APP_NAME=NL2SQL Agent
# One plain sentence describing what YOUR database holds. The agents read it to understand the
# subject, e.g. "Sales, products, customers and employees of a bicycle manufacturer".
# Blank is fine: the agents then work from the schema alone.
APP_DESCRIPTION=
# Folder with YOUR business_rules.md, few_shots.md and golden.jsonl (relative to backend/).
# Try the bundled sample with:  DOMAIN_DIR=../examples/adventureworks
DOMAIN_DIR=domain

# ── LLM provider ────────────────────────────────────────────────────────────────
# local            -> Qwen3 (or any Ollama model) via Ollama  (default)
# open / openai    -> OpenAI (OPENAI_MODEL) via OPENAI_API_KEY
LLM_PROVIDER=local

# Local (Ollama)
LLM_MODEL=qwen3.6:35b-a3b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_NUM_CTX=32768
# Optional: a small/fast model for cheap routing steps (orchestrator/planner/chitchat).
# Blank = use the main model (no change). Set this to speed up routing without touching SQL/analysis.
OLLAMA_FAST_MODEL=

# OpenAI (used only when LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Blank = OpenAI. Set it to use any OpenAI-COMPATIBLE server instead; OPENAI_MODEL and
# OPENAI_FAST_MODEL then name models on that server. Examples:
#   LM Studio   http://localhost:1234/v1        vLLM        http://localhost:8000/v1
#   OpenRouter  https://openrouter.ai/api/v1    Groq        https://api.groq.com/openai/v1
# A local server that needs no key works with OPENAI_API_KEY left blank.
OPENAI_BASE_URL=
# Optional fast routing model, e.g. gpt-4o-mini. Blank = use OPENAI_MODEL.
OPENAI_FAST_MODEL=

# ── Database (MS SQL) ───────────────────────────────────────────────────────────
DB_SERVER=your.server.ip
DB_PORT=1433
DB_NAME=your_database
DB_USER=readonly_user
DB_PASSWORD=your_password
# Leave DB_DRIVER blank to auto-detect (ODBC Driver 18 → 17 → SQL Server).
DB_DRIVER=
DB_ENCRYPT=yes
DB_TRUST_CERT=yes

# ── Behaviour / guardrails ──────────────────────────────────────────────────────
MAX_SQL_RETRIES=2          # SQL rewrites per sub-question on validation/DB error
MAX_ROWS=500               # row cap per query
QUERY_TIMEOUT=60           # seconds per query
# Schemas the chatbot may see/query, comma-separated (e.g. sales,production).
# Blank = every user schema in the database (dbo included). After changing it run:
#   python -m app.db.introspect
ALLOWED_SCHEMAS=
# Tables to hide from the chatbot even though their schema is allowed — backups, copies, staging
# leftovers. Comma-separated. Use "schema.table" to hide one exact table (preferred), or a bare
# "table" name to hide that name in EVERY allowed schema. Blank = hide nothing.
# A hidden table also disappears from the primary keys, foreign keys, inferred joins and value
# hints. Changing this rebuilds the cache on the next start automatically.
EXCLUDED_TABLES=
# Individual columns to hide, on top of the built-in secret-name filter (password/token/etc, which
# always applies). Comma-separated. Use "schema.table.column" to hide one exact column (preferred),
# "table.column" for that table in any schema, or a bare "column" name to hide it in EVERY table.
# A hidden column is also stripped from the primary keys and from any foreign key that touches it,
# so the model is never pointed at a column it cannot see. Blank = hide nothing.
EXCLUDED_COLUMNS=

# Per-LLM-request timeout. Without it a stalled provider call holds a worker thread (and its DB
# connection) forever, while /api/health still reports OK.
LLM_TIMEOUT=120            # seconds per LLM request
LLM_MAX_RETRIES=2          # provider-level retries on a transient network/5xx error

# ── Agentic loop ─────────────────────────────────────────────────────────────────
MAX_QUERIES=3              # max queries the planner may run per question (ReAct loop)
# Times the Verifier may send the SQL Author back to rewrite the query. Separate from
# MAX_SQL_RETRIES on purpose: sharing one budget let unrelated syntax errors earlier in the turn
# leave the Verifier with no rewrites left.
VERIFY_RETRIES=1
# How many previous exchanges (question + answer) the agents can see. 3 is the long-standing
# behaviour. Raising it costs little, but the router and the Verifier both read history, so raise
# it deliberately and re-test follow-up questions. 0 disables conversation memory entirely.
HISTORY_TURNS=3

# ── Observability ────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO             # DEBUG / INFO / WARNING — written to logs/chatbot.log
# Colour agent trace in the terminal. Defaults: ON for the API server, OFF for the CLI
# (so the CLI keeps its clean panels). Set false to silence it on the server.
LOG_CONSOLE=true
# Max characters per console line. 0 = show everything (full SQL, full verifier feedback).
LOG_CONSOLE_MAX_CHARS=0

# ── HTTP API ────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false           # true = auto-reload on code change (development only)
# Each worker loads its own schema + agent graph, so more workers cost more memory.
# NOTE: more than 1 requires EXPORT_SECRET to be set, or export links break across workers.
API_WORKERS=1
# Leave API_KEY blank for local dev. Set it and every request must send X-API-Key.
API_KEY=
# Comma-separated allowed origins for the browser UI; * allows any (dev only).
CORS_ORIGINS=*

# ── Export (download an answer's data as Excel / Word) ───────────────────────────
# SEPARATE FROM MAX_ROWS ON PURPOSE. MAX_ROWS limits how many rows reach the LLM prompt (a
# token-cost control), which is why a chat answer says "showing the first 20 of 40". An export
# has no LLM in it, so it returns EVERY row. Nothing in this section affects answers, the agent
# graph, or token usage.
#
# Upper bound on rows written to a file. Excel carries the full result (up to the .xlsx format's
# own 1,048,576-row sheet limit); Word is capped lower internally (5,000) because it is a document
# format, and says so in the file. Very large exports are memory-heavy — lower this if that
# matters more than completeness.
EXPORT_MAX_ROWS=1000000
# Export re-reads the full result, which takes longer than a 20-row preview, so it does not
# inherit QUERY_TIMEOUT.
EXPORT_QUERY_TIMEOUT=600
# How long a download link stays valid (seconds). 86400 = 24 hours.
EXPORT_TOKEN_TTL=86400
# Signs export links so only SQL THIS server wrote can ever be re-run — without it a caller could
# POST arbitrary SELECTs and read tables EXCLUDED_TABLES is meant to hide.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Must stay STABLE (changing it invalidates links already on screen) and MUST be set when
# API_WORKERS > 1, since every worker has to share the same key. If left blank the server
# generates a random per-process key and logs a warning — fine for local testing only.
EXPORT_SECRET=

# ── Reasoning tuning (main tier only) ────────────────────────────────────────────
# Per-agent reasoning_effort/verbosity are set in app/llm.py's _AGENT_TUNING and need no config:
#   sql_author high/low   verifier high/low   analysis medium/medium   synthesize low/medium
# The orchestrator, planner and chitchat are pinned to the FAST model, which is not a reasoning
# model, so these parameters are never sent on their calls.
#
# These two are the global override. Blank = use the per-agent table (the normal case). Setting a
# value forces it on EVERY main-tier agent, which is useful for an A/B run or to rule the feature
# out while debugging.
OPENAI_REASONING_EFFORT=
OPENAI_VERBOSITY=
# Set true when the main model accepts ONLY its default temperature. Analysis and the Synthesizer
# ask for 0.2; without this each pays a rejected call plus a silent retry on every turn. Confirm
# from the provider error in logs/chatbot.log before turning it on.
OPENAI_IGNORES_TEMPERATURE=false
# Make one throwaway call per model tier at startup, so the provider client's ONE-TIME cost is
# paid at boot instead of by whoever asks the first question. Measured: the first call in a
# process took 34s and every later one 2.2s, because get_llm() defers the heavy
# `import langchain_openai` until first use. Warming both tiers costs ~12s of startup and covers
# every agent, since the cost is process-wide rather than per-client.
# Set false in tests and CI, where it is a real network call per process.
LLM_WARMUP=true

# ── Langfuse tracing (optional, self-hosted) ─────────────────────────────────────
# ENTIRELY OPT-IN. Leave LANGFUSE_PUBLIC_KEY blank and nothing changes: no handler is attached,
# no network calls are made, and every code path is identical to before Langfuse existed.
# Turning tracing off later is just blanking the key + a restart — no code to revert.
#
# Self-hosted stack lives OUTSIDE this repo (cloned separately, started with docker compose).
# Langfuse's UI listens on 3000 by default; use whatever port you mapped it to (see README).
#
# Get the two keys from the Langfuse UI: Project -> Settings -> API Keys -> Create.
#
# ⚠ Traces store the FULL prompt AND response of every LLM call — for this pipeline that includes
# the schema, the business rules, and retrieved rows (employee names, phone numbers). Point this
# only at a trusted, access-controlled instance.
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Optional second kill switch honoured natively by the SDK: set to false to disable tracing even
# when keys are present. Optional sampling: LANGFUSE_SAMPLE_RATE=0.0-1.0 (1.0 = trace everything).
# LANGFUSE_TRACING_ENABLED=true
# LANGFUSE_SAMPLE_RATE=1.0

# ── Voice (optional: speak a question, hear the answer) ──────────────────────────
# The Python packages come with requirements.txt, but voice stays INACTIVE until ffmpeg is
# installed and the voice file is downloaded. Until then (or with VOICE_ENABLED=0)
# /api/voice/status reports unavailable, the mic never appears in the UI, and nothing else
# changes — voice only turns speech into text, sends it through the SAME chat flow, and reads the
# answer back.
#
# Setup (one time):
#   winget install Gyan.FFmpeg          # Windows;  apt-get install -y ffmpeg on Debian/Ubuntu
#   python scripts/setup_voice.py       # downloads the ~60 MB Piper voice
#   pip install -r requirements-voice.txt   # OPTIONAL, NVIDIA GPU only (~2 GB CUDA runtime)
VOICE_ENABLED=1
# Speech-to-Text (faster-whisper). "auto" sizes it from the hardware:
#   GPU >= 8 GB -> large-v3    GPU >= 4 GB -> small    no GPU -> base
# Pin explicitly with: tiny | base | small | medium | large-v3
STT_MODEL=auto
# Text-to-Speech: a Piper VOICE NAME, not a HuggingFace repo. Change this and restart the server —
# the voice is downloaded automatically the first time it speaks (~60 MB, once). Options:
#   en_US-ryan-medium    male,   US  (default)
#   en_US-lessac-medium  female, US
#   en_GB-alan-medium    male,   British
#   en_GB-cori-medium    female, British
TTS_MODEL=en_US-ryan-medium
# Language spoken to the speech-to-text model (ISO code, e.g. en, ar, hi). Default en.
VOICE_LANG=en
# auto | cuda | cpu. "auto" uses the GPU when one is usable and falls back to CPU automatically
# if the CUDA runtime libraries are missing.
VOICE_DEVICE=auto
# Blank = backend/models/piper inside the repo (what setup_voice.py fills). Set an absolute path
# to keep the voice files outside the project.
PIPER_DATA_DIR=
# Full path to ffmpeg if it is not on PATH (e.g. C:\ffmpeg\bin\ffmpeg.exe). Blank = find it.
FFMPEG_BINARY=
